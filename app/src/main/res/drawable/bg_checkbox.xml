                </vector>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/divider" />
            <size android:width="24dp" android:height="24dp" />
        </shape>
    </item>
</selector>