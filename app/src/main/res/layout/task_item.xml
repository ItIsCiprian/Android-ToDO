<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/list_item_spacing"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/elevation_small"
    android:background="@color/surface"
    app:rippleColor="@color/divider">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/task_item_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/task_item_padding_horizontal"
        android:paddingVertical="@dimen/task_item_padding_vertical"
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground">

        <!-- Checkbox -->
        <ImageView
            android:id="@+id/checkIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/bg_checkbox"
            android:layout_marginEnd="@dimen/spacing_md" />

        <!-- Task text -->
        <TextView
            android:id="@+id/textViewTask"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Task Name"
            android:textSize="@dimen/font_size_subtitle"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Priority indicator (optional) -->
        <View
            android:id="@+id/priorityIndicator"
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="@color/task_priority_medium"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>